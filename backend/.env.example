# HelixAudit Environment Variables
# Copy to .env and fill values for production

# Required in production - generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Optional: protect API with a key (send as X-API-Key header)
API_KEY=

# Database (default SQLite is fine for single instance)
DATABASE_URL=sqlite:///./helixaudit.db

# CORS - use specific frontend URL in production, e.g. https://your-frontend.vercel.app
CORS_ORIGINS=*

# Safety limits
MAX_CONCURRENT_SCANS=2
MAX_PAGES_CRAWL=25
MAX_CRAWL_DEPTH=2
